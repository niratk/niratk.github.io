---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found" description="Page not found.">
  <section class="py-16 text-center">
    <p class="font-mono text-sm text-zinc-500 dark:text-zinc-400">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
      Page not found
    </h1>
    <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
      The page you are looking for doesn&rsquo;t exist or has been moved.
    </p>
    <div class="mt-8">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 rounded-lg bg-zinc-950 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-zinc-200"
      >
        <span aria-hidden="true">&larr;</span>
        <span>Back to Home</span>
      </a>
    </div>
  </section>
</BaseLayout>
