---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ABOUT, SITE, SOCIAL_LINKS } from '@/data/site';
---

<BaseLayout title="About" description={`About ${SITE.author} — ${SITE.role}`}>
  <header class="pb-10">
    <h1
      class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl dark:text-zinc-50"
    >
      About Me
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
      {ABOUT.lead}
    </p>
  </header>

  <!-- Bio -->
  <section class="max-w-2xl space-y-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
    {ABOUT.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <!-- Timeline -->
  <section class="mt-14 border-t border-zinc-200/80 pt-12 dark:border-zinc-800/80">
    <h2 class="text-sm font-semibold tracking-wider text-zinc-500 uppercase dark:text-zinc-400">
      Experience &amp; Education
    </h2>
    <ol class="mt-6 space-y-8 border-l border-zinc-200 pl-6 dark:border-zinc-800">
      {
        ABOUT.timeline.map((item) => (
          <li class="relative">
            <span
              class="absolute -left-[29px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-zinc-400 dark:border-zinc-950 dark:bg-zinc-600"
              aria-hidden="true"
            />
            <p class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
              {item.period}
            </p>
            <h3 class="mt-1 text-base font-semibold text-zinc-950 dark:text-zinc-50">
              {item.role}
              <span class="font-normal text-zinc-500 dark:text-zinc-400">
                {' '}
                @ {item.organization}
              </span>
            </h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {item.summary}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Contact / Links -->
  <section class="mt-14 border-t border-zinc-200/80 pt-12 dark:border-zinc-800/80">
    <h2 class="text-sm font-semibold tracking-wider text-zinc-500 uppercase dark:text-zinc-400">
      Connect
    </h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group flex items-center justify-between rounded-xl border border-zinc-200/80 px-4 py-3 transition-colors hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800/80 dark:hover:border-zinc-700 dark:hover:bg-zinc-900/60"
          >
            <div>
              <p class="text-sm font-medium text-zinc-950 dark:text-zinc-50">
                {link.label}
              </p>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">
                {link.handle}
              </p>
            </div>
            <span
              aria-hidden="true"
              class="text-zinc-400 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-zinc-900 dark:group-hover:text-zinc-100"
            >
              &nearr;
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
