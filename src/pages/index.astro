---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { FOCUS_AREAS, SITE, SOCIAL_LINKS } from "@/data/site";
import { getPublishedPosts } from "@/utils/blog";

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 3);
---

<BaseLayout description={SITE.description}>
  <!-- Hero -->
  <section class="pb-14 sm:pb-16">
    <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">
      {SITE.role} &middot; {SITE.location}
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl dark:text-zinc-50">
      {SITE.author}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
      {SITE.tagline}
    </p>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
      {SITE.intro}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 rounded-lg bg-zinc-950 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-zinc-200"
      >
        <span>Read Blog</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        href="/about"
        class="inline-flex items-center rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-sm font-medium text-zinc-900 transition-colors hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-100 dark:hover:border-zinc-700 dark:hover:bg-zinc-900"
      >
        About Me
      </a>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
      {SOCIAL_LINKS.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100"
        >
          {link.label} &nearr;
        </a>
      ))}
    </div>
  </section>

  <!-- Focus Areas -->
  <section class="border-t border-zinc-200/80 py-14 dark:border-zinc-800/80">
    <h2 class="text-sm font-semibold tracking-wider text-zinc-500 uppercase dark:text-zinc-400">
      Focus Areas
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {FOCUS_AREAS.map((area) => (
        <div class="rounded-2xl border border-zinc-200/80 bg-zinc-50/50 p-5 dark:border-zinc-800/80 dark:bg-zinc-900/40">
          <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50">
            {area.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            {area.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Recent Posts -->
  <section class="border-t border-zinc-200/80 pt-14 dark:border-zinc-800/80">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-sm font-semibold tracking-wider text-zinc-500 uppercase dark:text-zinc-400">
        Recent Posts
      </h2>
      <a
        href="/blog"
        class="text-sm font-medium text-zinc-600 transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-100"
      >
        View all &rarr;
      </a>
    </div>

    {recentPosts.length > 0 ? (
      <div class="mt-6 grid gap-4">
        {recentPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="mt-6 text-sm text-zinc-500 dark:text-zinc-400">
        No posts published yet.
      </p>
    )}
  </section>
</BaseLayout>
