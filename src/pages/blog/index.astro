---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getAllTags, getPublishedPosts, getTagHref } from "@/utils/blog";

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout
  title="Blog"
  description="Technical notes on software engineering, web development, and mathematics."
>
  <header class="pb-10">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl dark:text-zinc-50">
          Blog
        </h1>
        <p class="mt-3 text-base text-zinc-600 dark:text-zinc-400">いろいろ</p>
      </div>
      <a
        href="/rss.xml"
        class="hidden shrink-0 rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-600 transition-colors hover:border-zinc-300 hover:text-zinc-950 sm:inline-flex dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-700 dark:hover:text-zinc-100"
      >
        RSS Feed
      </a>
    </div>

    {tags.length > 0 && (
      <nav
        aria-label="Filter by tag"
        class="mt-6 flex flex-wrap items-center gap-2"
      >
        <a
          href="/blog"
          aria-current="page"
          class="rounded-full bg-zinc-950 px-3 py-1 text-xs font-medium text-white dark:bg-zinc-100 dark:text-zinc-950"
        >
          All ({posts.length})
        </a>
        {tags.map((tag) => (
          <a
            href={getTagHref(tag.name)}
            class="rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-medium text-zinc-600 transition-colors hover:border-zinc-300 hover:text-zinc-950 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-400 dark:hover:border-zinc-700 dark:hover:text-zinc-100"
          >
            #{tag.name} ({tag.count})
          </a>
        ))}
      </nav>
    )}
  </header>

  {posts.length > 0 ? (
    <div class="grid gap-4">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  ) : (
    <p class="text-sm text-zinc-500 dark:text-zinc-400">
      No posts published yet.
    </p>
  )}
</BaseLayout>
