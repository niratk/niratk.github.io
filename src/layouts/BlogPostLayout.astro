---
import 'katex/dist/katex.min.css';
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import {
  estimateReadingTime,
  formatDate,
  formatIsoDate,
  getTagHref,
  type BlogPost,
} from '@/utils/blog';

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
  prevPost?: BlogPost;
  nextPost?: BlogPost;
}

const { post, headings, prevPost, nextPost } = Astro.props;
const readingTime = estimateReadingTime(post.body);
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
>
  <div class="mb-8">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      <span aria-hidden="true">&larr;</span>
      <span>Back to Blog</span>
    </a>
  </div>

  <div class:list={[hasToc ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_210px] lg:gap-12' : '']}>
    <article class="min-w-0">
      <header class="mb-10 border-b border-zinc-200 pb-8 dark:border-zinc-800">
        <div
          class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-500 dark:text-zinc-400"
        >
          <time datetime={formatIsoDate(post.data.pubDate)}>
            {formatDate(post.data.pubDate)}
          </time>
          {
            post.data.updatedDate && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>
                  Updated{' '}
                  <time datetime={formatIsoDate(post.data.updatedDate)}>
                    {formatDate(post.data.updatedDate)}
                  </time>
                </span>
              </>
            )
          }
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime} min read</span>
        </div>

        <h1
          class="mt-3 text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl dark:text-zinc-50"
        >
          {post.data.title}
        </h1>

        <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
          {post.data.description}
        </p>

        {
          post.data.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <a
                  href={getTagHref(tag)}
                  class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-0.5 text-xs font-medium text-zinc-600 transition-colors hover:border-zinc-300 hover:text-zinc-950 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-zinc-700 dark:hover:text-zinc-100"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <TableOfContents headings={headings} variant="mobile" />

      <div class="prose-content">
        <slot />
      </div>

      {
        (prevPost || nextPost) && (
          <nav
            aria-label="Post navigation"
            class="mt-14 grid gap-4 border-t border-zinc-200 pt-8 sm:grid-cols-2 dark:border-zinc-800"
          >
            <div>
              {prevPost && (
                <a
                  href={`/blog/${prevPost.id}`}
                  class="group block rounded-xl border border-zinc-200 p-4 transition-colors hover:border-zinc-300 hover:bg-zinc-50/70 dark:border-zinc-800 dark:hover:border-zinc-700 dark:hover:bg-zinc-900/50"
                >
                  <span class="text-xs text-zinc-500 dark:text-zinc-400">
                    &larr; Newer post
                  </span>
                  <p class="mt-1 font-medium text-zinc-900 group-hover:text-zinc-700 dark:text-zinc-100 dark:group-hover:text-zinc-300">
                    {prevPost.data.title}
                  </p>
                </a>
              )}
            </div>
            <div>
              {nextPost && (
                <a
                  href={`/blog/${nextPost.id}`}
                  class="group block rounded-xl border border-zinc-200 p-4 text-right transition-colors hover:border-zinc-300 hover:bg-zinc-50/70 dark:border-zinc-800 dark:hover:border-zinc-700 dark:hover:bg-zinc-900/50"
                >
                  <span class="text-xs text-zinc-500 dark:text-zinc-400">
                    Older post &rarr;
                  </span>
                  <p class="mt-1 font-medium text-zinc-900 group-hover:text-zinc-700 dark:text-zinc-100 dark:group-hover:text-zinc-300">
                    {nextPost.data.title}
                  </p>
                </a>
              )}
            </div>
          </nav>
        )
      }
    </article>

    <TableOfContents headings={headings} variant="sidebar" />
  </div>
</BaseLayout>
