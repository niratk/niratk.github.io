---
import { SITE, SOCIAL_LINKS } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-zinc-200/80 dark:border-zinc-800/80">
  <div
    class="mx-auto flex max-w-4xl flex-col items-start justify-between gap-4 px-6 py-10 text-sm text-zinc-500 sm:flex-row sm:items-center dark:text-zinc-400"
  >
    <p>&copy; {year} {SITE.author}. Built with Astro.</p>
    <div class="flex flex-wrap items-center gap-5">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/rss.xml"
        class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100"
      >
        RSS
      </a>
    </div>
  </div>
</footer>
