---
import {
  estimateReadingTime,
  formatDate,
  formatIsoDate,
  getTagHref,
  type BlogPost,
} from '@/utils/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const readingTime = estimateReadingTime(post.body);
---

<article
  class="group rounded-2xl border border-zinc-200/80 bg-white p-5 transition-all hover:border-zinc-300 hover:bg-zinc-50/50 dark:border-zinc-800/80 dark:bg-zinc-950 dark:hover:border-zinc-700 dark:hover:bg-zinc-900/40"
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400">
    <time datetime={formatIsoDate(post.data.pubDate)}>
      {formatDate(post.data.pubDate)}
    </time>
    <span aria-hidden="true">&middot;</span>
    <span>{readingTime} min read</span>
    {
      post.data.draft && (
        <span class="rounded bg-amber-100 px-1.5 py-0.5 font-medium text-amber-800 dark:bg-amber-950 dark:text-amber-300">
          Draft
        </span>
      )
    }
  </div>

  <h3 class="mt-2 text-lg font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">
    <a
      href={`/blog/${post.id}`}
      class="transition-colors group-hover:text-zinc-700 dark:group-hover:text-zinc-300"
    >
      {post.data.title}
    </a>
  </h3>

  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
    {post.data.description}
  </p>

  {
    post.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {post.data.tags.map((tag) => (
          <a
            href={getTagHref(tag)}
            class="rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-0.5 text-xs font-medium text-zinc-600 transition-colors hover:border-zinc-300 hover:text-zinc-950 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-zinc-700 dark:hover:text-zinc-100"
          >
            #{tag}
          </a>
        ))}
      </div>
    )
  }
</article>
