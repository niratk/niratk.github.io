---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'sidebar' | 'mobile';
}

const { headings, variant = 'sidebar' } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length > 0 &&
    (variant === 'mobile' ? (
      <details class="mb-8 rounded-xl border border-zinc-200 bg-zinc-50/70 px-4 py-3 text-sm lg:hidden dark:border-zinc-800 dark:bg-zinc-900/50">
        <summary class="cursor-pointer font-medium text-zinc-900 select-none dark:text-zinc-100">
          On this page
        </summary>
        <nav aria-label="Table of contents" class="mt-3 border-t border-zinc-200 pt-3 dark:border-zinc-800">
          <ul class="space-y-1.5">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? 'pl-3.5' : ''}>
                <a
                  href={`#${heading.slug}`}
                  class="block text-zinc-600 transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    ) : (
      <aside class="hidden lg:block">
        <div class="sticky top-24 border-l border-zinc-200 pl-4 dark:border-zinc-800">
          <p class="text-xs font-semibold tracking-wider text-zinc-900 uppercase dark:text-zinc-100">
            On this page
          </p>
          <nav aria-label="Table of contents" class="mt-3">
            <ul class="space-y-2 text-sm">
              {tocHeadings.map((heading) => (
                <li class={heading.depth === 3 ? 'pl-3' : ''}>
                  <a
                    href={`#${heading.slug}`}
                    class="block leading-snug text-zinc-500 transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    ))
}
